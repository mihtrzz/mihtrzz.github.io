[MITM]
hostname= %APPEND% api.revenuecat.com,api.rc-backup.com,firebaseremoteconfig.googleapis.com,api.locketcamera.com,us-central1-alight-creative.cloudfunctions.net,api.picsart.com,api-mobile.soundcloud.com,premium*.truecaller.com

[Script]

# Alight Motion
AlightMotion=type=http-response,pattern=https:\/\/us-central1-alight-creative\.cloudfunctions\.net\/getAccountStatusAndLicenses,requires-body=true,script-path=https://raw.githubusercontent.com/mihtrzz/origin/refs/heads/main/alightmotion.js

# Locket
Revenuecat=type=http-response,pattern=https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$),requires-body=true,timeout=60,script-path=https://raw.githubusercontent.com/mihtrzz/origin/refs/heads/main/locket.js
DeleteHeader=type=http-request,pattern=https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers),timeout=60,script-path=https://raw.githubusercontent.com/mihtrzz/origin/refs/heads/main/deleteheader.js
RemoteConfig=type=http-response,pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+,requires-body=true,timeout=60,script-path=https://raw.githubusercontent.com/mihtrzz/origin/refs/heads/main/remoteconfig.js
LocketBadge=type=http-request,pattern=^https:\/\/api\.locketcamera\.com\/changeProfileInfo,timeout=60,script-path=https://raw.githubusercontent.com/mihtrzz/origin/refs/heads/main/locketbadge.js
LocketUser=type=http-response,pattern=^https:\/\/api\.locketcamera\.com\/.+,requires-body=true,max-size=-1,timeout=60,script-path=https://raw.githubusercontent.com/mihtrzz/origin/refs/heads/main/locketbadge.js

# Picsart
Picsart=type=http-request,pattern=https://api.picsart.com/gw-v2/shop/subscription/apple/purchases,script-path=https://raw.githubusercontent.com/mihtrzz/origin/refs/heads/main/picsart.js

# SoundCloud
SoundCloud=type=http-response,pattern=https://api-mobile.soundcloud.com/configuration/ios,requires-body=1,script-path=https://raw.githubusercontent.com/mihtrzz/origin/refs/heads/main/soundcloud.js

# Truecaller
Truecaller=type=http-response,pattern=^https://premium-(.+)\.truecaller\.com/v\d/(subscriptions|products\/apple),requires-body=1,script-path=https://raw.githubusercontent.com/mihtrzz/origin/refs/heads/main/truecaller.js

# Vsco
Vsco=type=http-request,pattern=https?://api.revenuecat.com/.+/(receipts$|subscribers/?(.*?)*$),script-path=https://raw.githubusercontent.com/mihtrzz/origin/refs/heads/main/vsco.js
